*.jlink
JLinkLog.txt
JLinkSettings.ini

# --- OS generated files ---
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini
$RECYCLE.BIN/

# --- IDE / Editor ---
.vscode/
*.swp
*.swo
*~
*.code-workspace

# --- Temp / Cache ---
*.tmp
*.temp
*.log

# --- Python cache ---
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/

# --- Archives (keep source, exclude zips) ---
*.zip
*.rar
*.7z
